<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Dark only, edge-to-edge. This theme is only what the platform draws before the first Compose
      frame; the launch window uses the same near-black canvas as the app so there is no flash.
    -->
    <style name="Theme.NullWave" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nullwave_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
