<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".NullWaveApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NullWave">
        <!--
          Instantiatable is a false positive here: MainActivity is constructor-injected, and
          MetroX's MetroAppComponentFactory (merged in from the metrox-android AAR via
          android:appComponentFactory) is what constructs it. Lint only knows about the
          no-arg-constructor path.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            tools:ignore="Instantiatable"
            android:label="@string/app_name"
            android:theme="@style/Theme.NullWave"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
