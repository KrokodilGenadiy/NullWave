# Normalise to LF in the repository regardless of the machine committing.
* text=auto eol=lf

# Windows scripts must keep CRLF; gradlew must keep LF or it fails on Linux/macOS
# with "bad interpreter".
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Binary: never diff, never auto-merge, never line-ending-convert.
*.jar binary
*.ttf binary
*.otf binary
*.webp binary
*.png binary
*.jpg binary
# SQLDelight schema snapshots under app/src/main/sqldelight/databases/
*.db binary
